# Copy to .env; replace every blank password with a different local secret.
POSTGRES_DB=smartrent
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=
DB_MIGRATION_PASSWORD=
DB_PASSWORD=
# Backend runs on the host. These usernames match local bootstrap roles.
DB_URL=jdbc:postgresql://127.0.0.1:5432/smartrent
DB_USERNAME=smartrent_app
DB_MIGRATION_USERNAME=smartrent_migrator

# Optional B01 fixture: disabled unless explicitly enabled with only dev/test profiles.
# These passwords are unrelated to the three database-role passwords above.
SMARTRENT_DEV_ACCOUNTS_ENABLED=false
SMARTRENT_SEED_LANDLORD_ONE_PASSWORD=
SMARTRENT_SEED_LANDLORD_TWO_PASSWORD=
SMARTRENT_SEED_TENANT_ONE_PASSWORD=
SMARTRENT_SEED_TENANT_TWO_PASSWORD=
